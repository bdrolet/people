+// requireJSON refuses anything but an application/json body with no Origin header, so a
+// web page can't reach the bridge: a cross-site fetch with that content type needs a CORS
+// preflight this server never answers, and a browser always sends Origin on a POST.
+func requireJSON(w http.ResponseWriter, r *http.Request) bool {
+	if r.Header.Get("Origin") != "" || !strings.HasPrefix(r.Header.Get("Content-Type"), "application/json") {
+		http.Error(w, "Forbidden", http.StatusForbidden)
+		return false
+	}
+	return true
+}
+
+// bridgePort is WHATSAPP_BRIDGE_PORT, default 18765 (not 8080, which the people-api dev
+// server uses).
+func bridgePort() int {
+	var port int
+	if _, err := fmt.Sscanf(os.Getenv("WHATSAPP_BRIDGE_PORT"), "%d", &port); err != nil || port <= 0 {
+		return 18765
+	}
+	return port
+}
