# The Referral outreach dashboard and the LinkedIn sender's email alerts, in Ben's
# Grafana Cloud stack (outreach dashboard design). The dashboard JSON is generated by
# dashboards/outreach.py and committed; nothing here needs Python.
#
# No grafana_notification_policy: the stack's routing tree was made in the UI, and that
# resource would replace the whole tree. Each rule sends to ben-email directly through
# its notification_settings instead.

provider "grafana" {
  url  = var.grafana_url
  auth = data.google_secret_manager_secret_version.grafana_dashboards_token.secret_data
}

resource "grafana_folder" "people" {
  title = "People"
  uid   = "people"
}

resource "grafana_dashboard" "outreach" {
  folder      = grafana_folder.people.uid
  config_json = file("${path.module}/../dashboards/build/outreach.json")
  overwrite   = true
}

resource "grafana_contact_point" "ben_email" {
  name = "ben-email"
  email {
    addresses               = [var.alert_email]
    single_email            = true
    disable_resolve_message = false
  }
}

# The sender only sends weekdays 08:00-19:00 Pacific (LINKEDIN_SEND_WINDOW's default).
# A sleeping Mac at night or on a weekend must not page anyone.
resource "grafana_mute_timing" "linkedin_send_window_closed" {
  name = "linkedin-send-window-closed"
  intervals {
    weekdays = ["saturday", "sunday"]
    location = "America/Los_Angeles"
  }
  intervals {
    weekdays = ["monday:friday"]
    location = "America/Los_Angeles"
    times {
      start = "00:00"
      end   = "08:00"
    }
  }
  intervals {
    weekdays = ["monday:friday"]
    location = "America/Los_Angeles"
    times {
      start = "19:00"
      end   = "24:00"
    }
  }
}

locals {
  # Thresholds are Claude's first cut (design: "my call"); tune them here.
  linkedin_sender_rules = {
    silent = {
      name    = "LinkedIn sender silent"
      expr    = "time() - max(last_over_time(people_linkedin_sender_heartbeat[7d]))"
      above   = 1800
      for     = "5m"
      no_data = "Alerting" # nothing reported for a week is silence too
      repeat  = "4h"
      summary = "The LinkedIn sender has not run for over 30 minutes inside the send window."
      detail  = "Check the Mac is awake and the launchd agent cloud.drolet.people.linkedin-sender is loaded (~/Library/Logs/people-linkedin-sender.log)."
    }
    paused = {
      name    = "LinkedIn queue paused"
      expr    = "max by (reason) (last_over_time(people_linkedin_sender_paused[10m]))"
      above   = 0
      for     = "5m"
      no_data = "OK"
      repeat  = "4h"
      summary = "The LinkedIn queue is paused: {{ $labels.reason }}."
      detail  = "Login and captcha pauses need you: sign in again, then `outreach linkedin resume`. rate_limited clears itself; this is for information."
    }
    check_linkedin = {
      name    = "LinkedIn send needs checking"
      expr    = "max(last_over_time(people_linkedin_outbox{status=\"check_linkedin\"}[26h]))"
      above   = 0
      for     = "0m"
      no_data = "OK"
      repeat  = "24h"
      summary = "A LinkedIn send has an unknown outcome and needs checking by hand."
      detail  = "Look in LinkedIn, then `outreach linkedin result` (sent or not). This repeats daily until the row is resolved."
    }
    stuck = {
      name = "LinkedIn queue stuck"
      # Seconds the oldest queued message has waited inside the send window, while the
      # sender is alive (the [10m] reads go empty when it stops), not paused, and below
      # both ceilings.
      expr    = <<-EOT
        max(last_over_time(people_linkedin_queue_oldest_window_seconds[10m]))
          and on() (max(last_over_time(people_linkedin_sender_paused[10m])) == 0)
          and on() (max(last_over_time(people_linkedin_sends_today[10m])) < max(last_over_time(people_linkedin_cap_today[10m])))
          and on() (max(last_over_time(people_linkedin_sends_week[10m])) < max(last_over_time(people_linkedin_cap_week[10m])))
      EOT
      above   = 14400
      for     = "5m"
      no_data = "OK"
      repeat  = "4h"
      summary = "The LinkedIn sender is running but the oldest queued message has waited over 4 hours of send window."
      detail  = "See `outreach linkedin status` and the sender log."
    }
  }
}

resource "grafana_rule_group" "linkedin_sender" {
  name             = "linkedin-sender"
  folder_uid       = grafana_folder.people.uid
  interval_seconds = 60

  dynamic "rule" {
    for_each = local.linkedin_sender_rules
    content {
      name           = rule.value.name
      condition      = "C"
      for            = rule.value.for
      no_data_state  = rule.value.no_data
      exec_err_state = "Error"
      labels         = { service = "people-linkedin-sender" }
      annotations = {
        summary     = rule.value.summary
        description = rule.value.detail
      }

      notification_settings {
        contact_point   = grafana_contact_point.ben_email.name
        group_by        = ["alertname"]
        repeat_interval = rule.value.repeat
        mute_timings    = [grafana_mute_timing.linkedin_send_window_closed.name]
      }

      data {
        ref_id         = "A"
        datasource_uid = var.prometheus_datasource_uid
        relative_time_range {
          from = 600
          to   = 0
        }
        model = jsonencode({ refId = "A", expr = rule.value.expr, instant = true })
      }
      data {
        ref_id         = "B"
        datasource_uid = "__expr__"
        relative_time_range {
          from = 0
          to   = 0
        }
        model = jsonencode({ refId = "B", type = "reduce", expression = "A", reducer = "last" })
      }
      data {
        ref_id         = "C"
        datasource_uid = "__expr__"
        relative_time_range {
          from = 0
          to   = 0
        }
        model = jsonencode({
          refId      = "C"
          type       = "threshold"
          expression = "B"
          conditions = [{ evaluator = { type = "gt", params = [rule.value.above] } }]
        })
      }
    }
  }
}
