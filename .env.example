GCP_PROJECT_ID=bens-project-462804

# Graph auth (local import scripts only — people's Cloud Functions never talk to Graph)
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=

# Google Contacts (People API v1) — schedule's OAuth client + a people-owned refresh token
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CONTACT_GROUP=Inbox

# HubSpot
HUBSPOT_TOKEN=
HUBSPOT_OWNER_ID=
HUBSPOT_MAX_CONTACTS=1000
HUBSPOT_WRITES_ENABLED=false

# Eligibility filters
AUTOMATED_SENDER_DOMAINS=
OWN_ADDRESSES=

# Database (Cloud SQL instance "inbox", database "people")
CLOUD_SQL_CONNECTION_NAME=bens-project-462804:us-central1:inbox
POSTGRES_USER=people
POSTGRES_DB=people
POSTGRES_PASSWORD=

# API auth
PEOPLE_API_TOKEN=
PEOPLE_SYNC_TOKEN=

# Observability
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_TOKEN=
