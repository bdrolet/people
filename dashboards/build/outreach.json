        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": [],
      "title": "Is outreach producing results?",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Last 12 brief cohorts. Qualified = current verdict yes.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "options": null,
      "repeatDirection": "h",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (cohort_week, stage) (last_over_time(people_outreach_cohort{stage=~\"intro|qualified\",cohort_week!=\"none\",cohort_week=~\"$cohort\"}[26h]) and on(job, instance) topk(1, last_over_time(people_outreach_refreshed[26h])))",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Qualified leads and introductions per brief week",
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "cohort_week"
              }
            ]
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "stage",
            "rowField": "cohort_week",
            "valueField": "Value"
          }
        },
        {
          "id": "limit",
          "options": {
            "limitField": 12
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": false,
                "field": "cohort_week\\stage"
              }
            ]
          }
        }
      ],
      "transparent": false,
      "type": "barchart"
    },
