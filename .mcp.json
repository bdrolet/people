{
  "mcpServers": {
    "linkedin": {
      "command": "uvx",
      "args": [
        "mcp-server-linkedin@latest"
      ],
      "env": {
        "UV_HTTP_TIMEOUT": "300"
      }
    },
    "whatsapp": {
      "command": "uv",
      "args": [
        "--directory",
        "${HOME}/.whatsapp-mcp/src/whatsapp-mcp-server",
        "run",
        "--frozen",
        "main.py"
      ]
    },
    "imessage": {
      "command": ".venv/bin/python",
      "args": [
        "-m",
        "mcp_servers.imessage"
      ]
    }
  }
}
